# ===========================================================================
# Multilingual file for the TOS 7 Docker application "bazarrdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Bazarr"
auth         = "Bazarr"
version      = "@@VERSION@@"
descript     = "Bazarr is a subtitle manager for your movie and TV library. It watches the series and films you already track in Sonarr and Radarr, finds matching subtitles in your preferred languages, and keeps them in sync - including forced and hearing-impaired tracks. This package runs the LinuxServer.io Docker image as a non-root container and keeps the configuration, database and logs in the application data folder."
release_note = "1. First release: Bazarr 1.6.2 from the LinuxServer.io Docker Hub image, running as a non-root container. Configuration, database and logs are kept in the application data folder."
important    = "Requires DockerEngine (installed if missing); add a registry mirror if Docker Hub is unreachable. Open the app and connect Sonarr/Radarr plus at least one subtitle provider. Bazarr writes subtitles next to the video files, so its media folders must be mounted in docker-compose.yml - TOS Docker applications do not get access to shared folders by default. Settings and the database live in the application data folder; back it up before uninstalling with data removal."

[zh-cn]
name         = "Bazarr"
auth         = "Bazarr"
version      = "@@VERSION@@"
descript     = "Bazarr 是电影与剧集字幕管理器。它会读取你在 Sonarr / Radarr 里已有的片库，按你设定的语言自动查找匹配字幕并保持同步，支持强制字幕与听障字幕。本应用以非 root 容器运行 LinuxServer.io 的镜像，配置、数据库与日志都保存在应用数据目录中。"
release_note = "1. 首次发布：来自 LinuxServer.io Docker Hub 镜像的 Bazarr 1.6.2，以非 root 容器运行；配置、数据库与日志保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会提示安装）。镜像安装时从 Docker Hub 拉取，无法直连请先配置镜像加速。打开后需连接 Sonarr / Radarr 与至少一个字幕源。Bazarr 会把字幕写到视频文件旁边，因此需要在 docker-compose.yml 里挂载媒体目录——TOS 的 Docker 应用默认访问不到共享文件夹。配置与数据库在应用数据目录，卸载并删除数据前请先备份。"

[zh-hk]
name         = "Bazarr"
auth         = "Bazarr"
version      = "@@VERSION@@"
descript     = "Bazarr 是電影與劇集字幕管理器。它會讀取你在 Sonarr / Radarr 裡已有的片庫，按你設定的語言自動尋找匹配字幕並保持同步，支援強制字幕與聽障字幕。本應用以非 root 容器執行 LinuxServer.io 的映像，設定、資料庫與日誌都保存在應用資料目錄中。"
release_note = "1. 首次發佈：來自 LinuxServer.io Docker Hub 映像的 Bazarr 1.6.2，以非 root 容器執行；設定、資料庫與日誌保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會提示安裝）。映像安裝時從 Docker Hub 下載，無法直連請先設定映像加速。開啟後需連接 Sonarr / Radarr 與至少一個字幕來源。Bazarr 會把字幕寫到影片檔旁邊，因此需要在 docker-compose.yml 裡掛載媒體目錄——TOS 的 Docker 應用預設存取不到共享資料夾。設定與資料庫在應用資料目錄，解除安裝並刪除資料前請先備份。"

